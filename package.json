{
  "name": "eleven-zero-zero",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {"node": ">=22.13.0"},
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "start": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:full": "FULL_TEST=1 node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "build": "node scripts/build-hosted.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "preview:pages": "node scripts/preview-pages.mjs",
    "build:cloudflare": "node scripts/build-cloudflare.mjs",
    "preview:cloudflare": "node scripts/preview-pages.mjs --cloudflare",
    "package:cloudflare": "npm run build:cloudflare && python3 -B scripts/package-cloudflare.py",
    "db:generate": "node backend/node_modules/drizzle-kit/bin.cjs generate --config drizzle.config.ts",
    "db:seed": "node scripts/seed-database.mjs",
    "data:import": "node scripts/import-ratings.mjs",
    "data:historical": "node scripts/import-historical.mjs",
    "data:legends": "python3 -B scripts/import-legends.py"
  }
}
